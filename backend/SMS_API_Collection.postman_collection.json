              "mode": "raw",
              "raw": "{\n  \"name\": \"New Admin User\",\n  \"email\": \"newadmin@sms.edu\",\n  \"password\": \"Admin@123\",\n  \"role\": \"admin\",\n  \"phone\": \"+919876543000\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api","auth","register"] }
